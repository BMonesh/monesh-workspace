---
import { getCollection } from 'astro:content';

type FileNode = {
  label: string;
  href: string;
  featured?: boolean;
};

type FolderNode = {
  label: string;
  href: string;
  expanded: boolean;
  external?: boolean;
  children?: FileNode[];
};

const projectEntries = await getCollection(
  'projects',
  ({ data }) => !data.draft
);
const writingEntries = await getCollection(
  'writing',
  ({ data }) => !data.draft
);

const statusOrder: Record<string, number> = {
  Shipped: 0,
  WIP: 1,
  Archived: 2,
};

const sortedProjects = projectEntries.sort((a, b) => {
  const sa = statusOrder[a.data.status];
  const sb = statusOrder[b.data.status];
  if (sa !== sb) return sa - sb;
  return a.data.title.localeCompare(b.data.title);
});

const sortedWriting = writingEntries.sort((a, b) => {
  const da = a.data.publishedAt?.getTime() ?? -Infinity;
  const db = b.data.publishedAt?.getTime() ?? -Infinity;
  return db - da;
});

const tree: FolderNode[] = [
  {
    label: 'projects',
    href: '/projects',
    expanded: true,
    children: sortedProjects.map((e) => ({
      label: e.slug,
      href: `/projects/${e.slug}`,
      featured: e.data.featured,
    })),
  },
  {
    label: 'writing',
    href: '/writing',
    expanded: true,
    children: sortedWriting.map((e) => ({
      label: e.slug,
      href: `/writing/${e.slug}`,
      featured: e.data.featured,
    })),
  },
  { label: 'about', href: '/about', expanded: false },
  { label: 'contact', href: '/contact', expanded: false },
  {
    label: 'resume.pdf',
    href: '/resume.pdf',
    expanded: false,
    external: true,
  },
];

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
// Spec §4.1 — on `/` the about node is the active selection.
const activePath = pathname === '/' ? '/about' : pathname;

const allHrefs: string[] = [];
for (const node of tree) {
  allHrefs.push(node.href);
  if (node.children && node.expanded) {
    for (const c of node.children) allHrefs.push(c.href);
  }
}
const focusTarget = allHrefs.includes(activePath) ? activePath : allHrefs[0];
---

<nav
  class="font-mono text-[12px] leading-[1.45] h-full"
  style="padding: 12px 8px;"
  aria-label="workspace tree"
>
  <div
    class="text-mute-2 uppercase tracking-[0.06em] text-[10px] mb-2 px-2"
    aria-hidden="true"
  >
    workspace
  </div>
  <ul role="tree" data-file-tree class="flex flex-col">
    {
      tree.map((node) => {
        const folderActive = node.href === activePath;
        const caret = node.children ? (node.expanded ? '▾' : '▸') : '▸';
        return (
          <li role="none">
            <a
              href={node.href}
              target={node.external ? '_blank' : undefined}
              rel={node.external ? 'noopener noreferrer' : undefined}
              role="treeitem"
              aria-current={folderActive ? 'page' : undefined}
              aria-expanded={node.children ? node.expanded : undefined}
              data-tree-row
              tabindex={focusTarget === node.href ? 0 : -1}
              class="flex items-center gap-1 px-2 py-[3px]"
            >
              <span
                class="w-3 inline-flex justify-center text-mute-2"
                aria-hidden="true"
              >
                {caret}
              </span>
              <span class="flex-1 truncate">{node.label}</span>
              {folderActive ? (
                <span class="text-accent text-[10px]" aria-hidden="true">
                  ●
                </span>
              ) : node.external ? (
                <span class="text-mute-2 text-[10px]" aria-hidden="true">
                  ↗
                </span>
              ) : null}
            </a>
            {node.children && node.expanded && (
              <ul role="group" class="flex flex-col">
                {node.children.map((child) => {
                  const childActive = child.href === activePath;
                  return (
                    <li role="none">
                      <a
                        href={child.href}
                        role="treeitem"
                        aria-current={childActive ? 'page' : undefined}
                        data-tree-row
                        tabindex={focusTarget === child.href ? 0 : -1}
                        class="flex items-center gap-1 py-[3px] pl-7 pr-2"
                      >
                        <span class="flex-1 truncate">{child.label}</span>
                        {childActive ? (
                          <span class="text-accent text-[10px]" aria-hidden="true">
                            ●
                          </span>
                        ) : child.featured ? (
                          <span class="text-ink-3 text-[10px]" aria-hidden="true">
                            ★
                          </span>
                        ) : null}
                      </a>
                    </li>
                  );
                })}
              </ul>
            )}
          </li>
        );
      })
    }
  </ul>
</nav>

<script>
  import '../scripts/file-tree-nav';
</script>
