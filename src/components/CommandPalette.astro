---
// Command palette — spec §3.3 / §3.2 / §7.
// Server-rendered shell with no JS-dependent content.
// Initial `data-open="false"`; the controller toggles to "true" via
// ⌘K / Ctrl+K, the status-bar trigger, or programmatic open.
---

<div
  id="command-palette"
  role="dialog"
  aria-modal="true"
  aria-labelledby="command-palette-label"
  data-open="false"
>
  <div data-palette-scrim></div>
  <div data-palette-panel>
    <h2 id="command-palette-label" class="sr-only">command palette</h2>

    <div class="palette-input-row">
      <span class="palette-prompt" aria-hidden="true">&gt;</span>
      <input
        data-palette-input
        type="text"
        role="combobox"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
        aria-expanded="true"
        aria-controls="palette-results"
        aria-autocomplete="list"
        aria-label="search workspace"
        placeholder="type to search"
      />
      <kbd class="palette-trigger-badge" aria-hidden="true">&#8984;K</kbd>
    </div>

    <ul
      id="palette-results"
      data-palette-results
      role="listbox"
      aria-label="results"
    ></ul>

    <div class="palette-footer" aria-hidden="true">
      <span><kbd>&uarr;&darr;</kbd> navigate</span>
      <span><kbd>&crarr;</kbd> select</span>
      <span><kbd>tab</kbd> cycle verb</span>
      <span><kbd>esc</kbd> close</span>
    </div>
  </div>
</div>

<script>
  import '../scripts/command-palette';
</script>
