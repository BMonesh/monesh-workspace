---
// Mobile-only top bar (<1024px). Hidden on desktop via CSS.
// Left: hamburger toggles the drawer. Center: trimmed breadcrumb of the
// current route. Right: ⌘K affordance, reuses the existing palette
// click-delegation (no controller change needed).

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const segments = pathname === '/' ? [] : pathname.split('/').filter(Boolean);
const trail = segments.slice(-2);
const omitted = segments.length > 2;
const prefix = segments.length === 0 ? '~/monesh' : omitted ? '…' : '~';
---

<header class="mobile-topbar" aria-label="mobile navigation">
  <button
    type="button"
    class="mobile-menu-btn"
    data-drawer-trigger
    aria-label="open navigation"
    aria-controls="mobile-drawer"
    aria-expanded="false"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M4 6l16 0"></path>
      <path d="M4 12l16 0"></path>
      <path d="M4 18l16 0"></path>
    </svg>
  </button>
  <nav class="mobile-breadcrumb" aria-label="breadcrumb">
    {
      segments.length === 0 ? (
        <span class="mobile-breadcrumb-last">{prefix}</span>
      ) : (
        <Fragment>
          <span class="mobile-breadcrumb-prefix">{prefix}</span>
          {trail.map((seg, i) => (
            <Fragment>
              <span class="mobile-breadcrumb-sep" aria-hidden="true">
                /
              </span>
              <span
                class={
                  i === trail.length - 1 ? 'mobile-breadcrumb-last' : undefined
                }
              >
                {seg}
              </span>
            </Fragment>
          ))}
        </Fragment>
      )
    }
  </nav>
  <button
    type="button"
    class="mobile-palette-btn"
    data-palette-trigger
    aria-label="open command palette"
  >
    <span aria-hidden="true">&#8984;K</span>
  </button>
</header>
