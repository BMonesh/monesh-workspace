---
import '../styles/global.css';
import StatusBar from '../components/StatusBar.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'monesh',
  description = 'Personal engineering portfolio of Monesh B.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).toString()} />
    <title>{title}</title>
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('monesh:theme');
          var mode =
            stored === 'light' || stored === 'dark' || stored === 'system'
              ? stored
              : 'system';
          var effective =
            mode === 'system'
              ? window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light'
              : mode;
          document.documentElement.setAttribute('data-theme', effective);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:bg-paper-2 focus:text-ink focus:px-2 focus:py-1 focus:rounded-sm"
      >skip to content</a
    >
    <main id="main" class="flex-1">
      <slot />
    </main>
    <StatusBar />
  </body>
</html>
