---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';
import StatusBar from '../components/StatusBar.astro';
import FileTree from '../components/FileTree.astro';
import CommandPalette from '../components/CommandPalette.astro';
import MobileTopBar from '../components/MobileTopBar.astro';
import MobileDrawer from '../components/MobileDrawer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'monesh',
  description = 'Personal engineering portfolio of Monesh B.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).toString()} />
    <title>{title}</title>
    <ViewTransitions />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('monesh:theme');
          var mode =
            stored === 'light' || stored === 'dark' || stored === 'system'
              ? stored
              : 'system';
          var effective =
            mode === 'system'
              ? window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light'
              : mode;
          document.documentElement.setAttribute('data-theme', effective);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:bg-paper-2 focus:text-ink focus:px-2 focus:py-1 focus:rounded-sm focus:z-10"
      >skip to content</a
    >
    <MobileTopBar />
    <div class="flex-1 grid lg:grid-cols-[var(--rail-w)_1fr] min-h-0">
      <aside
        class="hidden lg:block border-r-[0.5px] overflow-y-auto"
        aria-label="workspace"
      >
        <FileTree />
      </aside>
      <main
        id="main"
        class="min-w-0"
        style="padding: var(--pane-pad-y) var(--pane-pad-x);"
      >
        <div class="lg:max-w-[68ch]">
          <slot />
        </div>
      </main>
    </div>
    <StatusBar />
    <CommandPalette />
    <MobileDrawer />
  </body>
</html>
